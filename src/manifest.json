{
  "manifest_version": 3,
  "name": "Prompt Vault",
  "version": "0.1.0",
  "description": "Local-first prompt manager with command palette and in-browser vector search.",
  "permissions": [
    "commands",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Toggle Prompt Palette"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/palette.html",
        "ui/palette.js",
        "ui/styles.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Prompt Vault"
  }
}
